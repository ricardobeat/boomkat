+    return true;
+}
+
+fn ulong FunctionFlow.boxed_snapshot(&self) @feat(SLJIT) {
+    ulong state = (ulong)self.boxed_dirty << 32;
+    for (uint i = 0; i < 3; i++) if ((self.boxed_dirty & (1U << i)) != 0) state |= (ulong)self.boxed_owners[i] << (i * 8);
+    return self.boxed_dirty != 0 ? state : 0;
+}
+fn void FunctionEmitter.boxed_exit(&self, ulong state) @feat(SLJIT) {
+    for (uint i = 0; i < 3; i++) if (((state >> 32) & (1UL << i)) != 0) {
+        self.out.e.mov(jit::SLJIT_MEM | self.out.state_base(), loop_value_offset((uint)((state >> (i * 8)) & 255)), jit::reg_r((int)i + 4), 0);
+    }
+}
+
+fn bool FunctionFlow.boxed_integer(&self, uint reg, uint pc) @feat(SLJIT) {
+    if (!self.boxed_enabled || self.boxed_cf == null) return false;
+    Instruction ins = self.boxed_cf.code[pc];
+    if (ins.a != reg) return false;
+    switch (ins.op) {
+        case LDINT: case TONUMERIC: case INC: case INC_LT: case DEC:
+        case BAND: case BOR: case BXOR: case SHL: case SHR: case USHR:
+        case BANDI: case BORI: case BXORI: case SHLI: case SHRI: case USHRI: case BNOT: return true;
+        case LDREG: return self.fastints[ins.b];
+        default: return false;
+    }
+}
