+        self.e.mov(jit::SLJIT_MEM | self.state_base(), loop_value_offset(flow.boxed_owners[slot]), jit::reg_r((int)slot + 4), 0);
+    }
+    flow.boxed_dirty &= ~(1U << slot);
+    if ((flow.boxed_used & (1U << slot)) != 0) flow.boxed[flow.boxed_owners[slot]] = 0;
+    flow.boxed_used |= 1U << slot;
+    flow.boxed_owners[slot] = reg;
+    flow.boxed[reg] = (char)jit::reg_r((int)slot + 4);
+    self.e.mov(flow.boxed[reg], 0, jit::reg_r(0), 0);
