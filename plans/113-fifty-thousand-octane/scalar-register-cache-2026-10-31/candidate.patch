+        if (ins.b == reg || ins.c == reg || ((ins.op == Opcode.INC || ins.op == Opcode.INC_LT || ins.op == Opcode.DEC) && ins.a == reg)) { used = true; break; }
+        if (ins.a == reg && ins.op != Opcode.NOP) break;
