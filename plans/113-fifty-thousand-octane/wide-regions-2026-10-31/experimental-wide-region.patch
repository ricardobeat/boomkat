+// Bound hot widened regions admitted from the loop reserve separately.
+fn bool sljit_wide_reserve_room(Heap* h, usz bytes) @feat(SLJIT) {
+    $if $feat(SLJIT_LOOP_RESERVE) && !$feat(SLJIT_ADAPTIVE):
+        if (bytes > 64 * 1024 || !sljit_code_room(h, bytes, false)) return false;
+        usz used;
+        for (uint i = 0; i < h.compiled_func_count; i++) {
+            CompiledFunction* existing = h.compiled_funcs[i];
+            if (existing == null || existing.sljit_function == null) continue;
+            FunctionPlan* p = existing.sljit_function;
+            if (p.begin != 0 && p.begin < existing.code_count && existing.code[p.begin].op == Opcode.WIDE) used += p.code_bytes;
+        }
+        return used + bytes <= 128 * 1024;
+    $else
+        return false;
+    $endif
+}
