+// Execute the widened region emitter directly so every recovery PC and the
+// real high-register homes are checked independently of JIT warmup policy.
+fn void check_wide_function_region(JsRuntime* runtime, JsContext* context) {
+    Instruction[15] code = {
+        bytecode::make_wide(1, 0, 0), bytecode::make_a_sbx(Opcode.LDINT, 44, 3),
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.BOR, 45, 44, 144),
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.ADD, 46, 45, 44),
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.EQ, 47, 46, 46),
+        bytecode::make_wide(1, 0, 0), bytecode::make_a_sbx(Opcode.IF_FALSE, 47, 2),
+        bytecode::make_wide(1, 1, 0), bytecode::make_abc(Opcode.LDREG, 48, 46, 0),
+        bytecode::make_wide(1, 0, 0), bytecode::make_a_sbx(Opcode.LDINT, 49, 7),
+        bytecode::make_abc(Opcode.RET, 0, 0, 0)
+    };
+    CompiledFunction cf = { .code = &code[0], .code_count = 15, .num_regs = 512 };
+    // Cache allocation can fail independently of bytecode execution. A region
+    // beginning after PC 0 must not turn null cache pointers into fake entries.
+    ColdCtx no_cache = { .heap = runtime.rt.heap };
+    @check(vm::sljit_function_compile(&cf, &no_cache, 2) == null);
+    ICEntry only_property_cache; VarICEntry only_variable_cache;
+    cf.ic_entries = &only_property_cache;
+    @check(vm::sljit_function_compile(&cf, &no_cache, 2) == null);
+    cf.ic_entries = null; cf.var_ic_entries = &only_variable_cache;
+    @check(vm::sljit_function_compile(&cf, &no_cache, 2) == null);
+    cf.var_ic_entries = null;
+    void*[15] entries;
+    FunctionPlan plan = { .entries = &entries[0] };
+    @check(vm::function_emit_wide(&plan, &cf, runtime.rt.heap));
+    defer jit::sljit_free_code((void*)plan.native, null);
+    TVal[512] regs;
+    for (uint i = 0; i < regs.len; i++) regs[i].set_undefined();
+    FunctionRun run = { .entry = entries[0] };
+    regs[400].set_fastint(2);
+    @check(plan.native(&regs[0], null, &run) == &code[14]);
+    @check(regs[300].get_fastint() == 3 && regs[301].get_fastint() == 3);
+    @check(regs[302].get_fastint() == 6 && regs[304].get_fastint() == 6 && regs[305].get_fastint() == 7);
+    regs[400].set_undefined(); regs[301].set_fastint(91);
+    @check(plan.native(&regs[0], null, &run) == &code[2]);
+    @check(regs[300].get_fastint() == 3 && regs[301].get_fastint() == 91);
+    @check(entries[1] == null && entries[3] == null && entries[9] == null);
+    run.entry = entries[8]; regs[303].set_boolean(false); regs[304].set_fastint(91);
+    @check(plan.native(&regs[0], null, &run) == &code[14]);
+    @check(regs[304].get_fastint() == 91 && regs[305].get_fastint() == 7);
+    run.entry = entries[8]; regs[303].set_undefined();
+    @check(plan.native(&regs[0], null, &run) == &code[8]);
+
+    eval(context, "var wideNativeArray = new Int8Array([11,22,33]);");
+    Heap* h = runtime.rt.heap;
+    HObject* globals = runtime.rt.vm.global_env.bindings;
+    int array_idx = globals.find_prop_idx(h.str_intern("wideNativeArray"), h);
+    @check(array_idx >= 0);
+    TVal array = globals.prop_values()[array_idx].get();
+    @check(array.is_object());
+    Instruction[9] typed_code = {
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.GETPROP, 44, 144, 145),
+        bytecode::make_wide(1, 0, 0), bytecode::make_a_sbx(Opcode.LDINT, 45, 77),
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.PUTPROP, 144, 145, 45),
+        bytecode::make_wide(1, 1, 1), bytecode::make_abc(Opcode.GETPROP, 46, 144, 145),
+        bytecode::make_abc(Opcode.RET, 0, 0, 0)
+    };
+    ICEntry[9] feedback;
+    feedback[1].typed_kind = (char)(ObjClass.INT8ARRAY.ordinal + 1);
+    feedback[5].typed_kind = feedback[1].typed_kind;
+    feedback[7].typed_kind = feedback[1].typed_kind;
+    CompiledFunction typed_cf = { .code = &typed_code[0], .code_count = 9, .num_regs = 512,
+        .ic_entries = &feedback[0] };
+    void*[9] typed_entries;
+    FunctionPlan typed_plan = { .entries = &typed_entries[0] };
+    @check(vm::function_emit_wide(&typed_plan, &typed_cf, h));
+    defer jit::sljit_free_code((void*)typed_plan.native, null);
+    regs[400] = array; regs[401].set_fastint(1);
+    run.entry = typed_entries[0];
+    @check(typed_plan.native(&regs[0], null, &run) == &typed_code[8]);
+    @check(regs[300].get_fastint() == 22 && regs[302].get_fastint() == 77);
+    eval(context, "if(wideNativeArray[1]!==77)throw 'wide typed store';wideNativeArray[1]=22;");
+    // A later destination that owns its last string reference refuses after
+    // the typed store, preserving that already-completed effect exactly once.
+    void* unique = h.alloc_concat_string("wide-owned", 10);
+    @check(unique != null);
+    regs[302].set_string(unique);
+    @check(((HeapHeader*)unique).refcount == 1);
+    @check(typed_plan.native(&regs[0], null, &run) == &typed_code[6]);
+    @check(regs[302].get_heapptr() == unique);
+    eval(context, "if(wideNativeArray[1]!==77)throw 'wide committed store';");
+    h.decref_tval(&regs[302]); regs[302].set_undefined();
+    regs[401].set_fastint(-1); regs[300].set_fastint(123);
+    @check(typed_plan.native(&regs[0], null, &run) == &typed_code[0]);
+    @check(regs[300].get_fastint() == 123);
+    regs[400].set_fastint(7); regs[401].set_fastint(1);
+    @check(typed_plan.native(&regs[0], null, &run) == &typed_code[0]);
+}
