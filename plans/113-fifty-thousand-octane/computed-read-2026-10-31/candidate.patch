diff --git a/test/capi/jit.c3 b/test/capi/jit.c3
index 8f6dd3db..d03fedd4 100644
--- a/test/capi/jit.c3
+++ b/test/capi/jit.c3
@@ -96,6 +96,21 @@ fn void eval(JsContext* ctx, String source) {
     ctx.release(value);
 }
 
+// Prove the computed-key miss actually returns through the native helper.
+fn void check_computed_read_continuation(JsRuntime* rt, JsContext* ctx) {
+    eval(ctx, "function computedContinue(o,k){return o[k]+1;}var computedRecord={alpha:10,beta:20};for(var i=0;i<300;i++)if(computedContinue(computedRecord,'alpha')!==11)throw 'warm';");
+    CompiledFunction* cf = named_function(rt, "computedContinue");
+    @check(cf != null && cf.sljit_function != null);
+    FunctionPlan* plan = cf.sljit_function;
+    ulong before;
+    for (uint i = 0; i < vm::FUNCTION_OPS; i++) before += plan.read_hits[i];
+    eval(ctx, "for(var i=0;i<80;i++)if(computedContinue(computedRecord,'beta')!==21)throw 'computed';");
+    @check(cf.sljit_function == plan);
+    ulong after;
+    for (uint i = 0; i < vm::FUNCTION_OPS; i++) after += plan.read_hits[i];
+    @check(after > before);
+}
