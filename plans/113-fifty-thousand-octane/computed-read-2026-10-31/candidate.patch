diff --git a/src/vm/vm_sljit_native.c3 b/src/vm/vm_sljit_native.c3
index a909003b..4b78476d 100644
--- a/src/vm/vm_sljit_native.c3
+++ b/src/vm/vm_sljit_native.c3
@@ -12,6 +12,18 @@ fn bool function_read_op(Opcode op) @feat(SLJIT) {
     return op == Opcode.GETPROPC || op == Opcode.GETPROPC_CACHED || op == Opcode.GETTHISC;
 }
 
+// Computed reads are admitted only at sites whose existing feedback names a
+// non-index key. Numeric element sites should not acquire a helper join that
+// cannot serve them. Every actual key remains checked by the helper.
+fn bool function_continuable_read_at(CompiledFunction* cf, uint pc) @feat(SLJIT) {
+    Instruction ins = cf.code[pc];
+    if (function_read_op(ins.op)) return true;
+    if ((ins.op != Opcode.GETPROP && ins.op != Opcode.GETPROP_CACHE) || cf.ic_entries == null) return false;
+    ICEntry* ic = (ICEntry*)cf.ic_entries + pc;
+    HString* key = ic.key.borrow();
+    return key != null && !key.is_arridx();
+}
