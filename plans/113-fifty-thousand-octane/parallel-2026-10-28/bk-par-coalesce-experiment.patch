+// These operations read all operands before writing the result, and SLJIT
+// permits the destination to overlap either input. A loop recovery frame
+// extends an input's lifetime past the definition when it still needs it.
+fn bool ssa_reuse_operand(SsaOp op) @feat(SLJIT) {
+    switch (op) {
+        case ADD: case SUB: case MUL: case DIV:
+        case BAND: case BOR: case BXOR: case SHL: case SHR: case USHR:
+        case BNOT: case NEG: return true;
+        default: return false;
+    }
+}
