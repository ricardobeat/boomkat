+// Experimental baseline dispatcher: native code publishes registers before
+// transferring a call or return. Every live JS frame remains an ordinary VM
+// activation, so a guard failure can resume the interpreter without replay.
+fn Instruction* sljit_function_entry(Instruction* pc, TVal* regs, ColdCtx* cold,
+                                      bool region = false) @feat(SLJIT) @noinline {
+    Vm* vm = cold.vm;
+    for (uint transfers = 0; transfers < 1024; transfers++) {
+        Instruction* next = pc;
+        if (pc.op != Opcode.RET && pc.op != Opcode.RETUNDEF) {
+            bool ran;
+            next = sljit_function_run(pc, regs, cold, region, &ran);
+            if (!ran) return pc;
+            pc = next;
+        }
+        region = false;
+        if (cold.heap.gc_phase != GcPhase.IDLE || cold.heap.interrupt_due
+            || cold.heap.uncatchable_throw
+            || std::core::mem::@atomic_load(cold.heap.interrupt_requested) != 0) return pc;
+        if (pc.op == Opcode.CALL || pc.op == Opcode.CALL_UNDEF_THIS) {
+            Instruction call = *pc;
+            bool plain = call.op == Opcode.CALL_UNDEF_THIS;
+            CompiledFunction* target = th_lean_target(vm, regs[call.b], regs + call.b + 2, plain);
+            if (target == null || target.arguments_in_reg()) return pc;
+            if (target.sljit_function_calls == uint::max
+                || (target.sljit_function != null && !sljit_function_resumes(target.code, target))) return pc;
+            TVal receiver = th_undefined();
+            bool this_valid;
+            if (!plain) {
+                TVal value = regs[call.b + 1];
+                if (value.is_heap_allocated()) {
+                    if (!value.is_object() || value.get_heapptr() == null
+                        || call.b + 1 >= vm.current_func.num_regs
+                        || cold.act.heap_reg_count <= call.b + 1) return pc;
+                    if (!target.call_flags.ignores_this) {
+                        receiver = value;
+                        this_valid = true;
+                    }
+                } else if (!target.call_flags.ignores_this) return pc;
+            }
+            if (th_call_gate(cold)) return pc;
+            FunctionPlan* caller_plan = vm.current_func.sljit_function;
+            next = th_enter_lean(pc, &g_threaded_table, regs, cold, target,
+                                 call.b, call.a, call.c, false, plain,
+                                 receiver, this_valid, null, true);
+            if (next == pc) return pc;
+            caller_plan.native_call_transfers++;
+            pc = next;
+            regs = cold.act.bottom;
+            continue;
+        }
+        if (pc.op == Opcode.RET || pc.op == Opcode.RETUNDEF) {
+            Activation* act = cold.act;
+            if (!th_frame_is_replaceable(vm, act) || !th_tracked_regs_uncounted(act)
+                || cold.heap.gc_safepoint_due(false)) return pc;
+            Activation* caller = &vm.activations[vm.activation_count - 2];
+            CompiledFunction* cf = (CompiledFunction*)caller.func;
+            if (cf == null || cf.realm != cold.heap.realm || cf.ic_entries == null) return pc;
+            TVal value = th_undefined();
+            if (pc.op == Opcode.RET) value = regs[pc.a];
+            if (value.is_refcounted() || act.retval.is_refcounted()) return pc;
+            if (value.is_heap_allocated() && (!value.is_object() || value.get_heapptr() == null
+                || act.retval < caller.bottom || act.retval >= caller.bottom + cf.num_regs)) return pc;
+            if (vm.current_func.sljit_function != null) ((FunctionPlan*)vm.current_func.sljit_function).native_return_transfers++;
+            th_clear_tracked_regs(act);
+            *act.retval = value;
+            if (value.is_heap_allocated()) track_heap_store(caller, act.retval, (uint)(act.retval - caller.bottom));
+            vm.valstack_top = act.caller_valstack_top;
+            act.release_callee(cold.heap);
+            vm.activation_count--;
+            vm.gc_root_frame_count_changed();
+            cold.act = caller;
+            vm.current_func = cf;
+            vm.valstack_bottom = caller.bottom;
+            *cold.regs_base_ptr = caller.bottom;
+            th_bind_ic_bias(cold, cf.code, cf.ic_entries, cf.var_ic_entries);
+            pc = caller.curr_pc;
+            regs = caller.bottom;
+            if (!sljit_function_resumes(pc, cf)) return pc;
+            continue;
+        }
+        return pc;
+    }
+    return pc;
+}
