diff --git a/test/jit_numeric_locals.js b/test/jit_numeric_locals.js
index eee93b9f..379f61fc 100644
--- a/test/jit_numeric_locals.js
+++ b/test/jit_numeric_locals.js
@@ -29,3 +29,23 @@ var calls = 0;
 if (sum(3, { valueOf: function () { calls++; return 4; } }, -1) !== 7 || calls !== 1)
     throw Error("coercion recovery");
 print("numeric locals ok");
+
+// A fresh call can initialize a canonical home from the numeric prefix.
+// Property misses and type changes must still recover the live accumulator.
+function initializedLocal(n, item) {
+    var total = 0.5;
+    for (var i = 0; i < n; i++) {
+        if (i & 1) total = total + item.x;
+        else total = total + item.y;
+    }
+    return total;
+}
+for (var warm = 0; warm < 200; warm++) {
+    if (initializedLocal(100, {x: 1.5, y: 2.5}) !== 200.5)
+        throw Error("initialized home");
+}
+calls = 0;
+var changing = {x: {valueOf: function () { calls++; return 3; }}, y: 2};
+if (initializedLocal(4, changing) !== 10.5 || calls !== 2)
+    throw Error("initialized home recovery");
+if (initializedLocal(0, changing) !== 0.5) throw Error("zero trip home");
