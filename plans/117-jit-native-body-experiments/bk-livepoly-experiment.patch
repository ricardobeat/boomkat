+
+// Read the live own-property arm set after a compiled shape guard misses.
+// Named sites have an immutable key; shape retirement purges their IC arms.
+fn void FunctionEmitter.read_poly_fallback(&self, uint pc) @feat(SLJIT) {
+    if (self.plan.numeric_homes != 0) return;
+    Instruction ins = self.cf.code[pc];
+    ICEntry* ic = (ICEntry*)self.cf.ic_entries + pc;
+    if (ic.has_proto || ic.prop_flags.is_accessor || ic.prop_idx >= hobject::IC_PROP_MISSING
+        || ic.shape_id == heap::SHAPE_NONE) return;
+    TemplateEmitter* e = &self.out.e;
+    LoopEmitter guards = { .e = *e, .plan = self.out.plan, .function_mode = true };
+    int r0 = jit::reg_r(0);
+    int r1 = jit::reg_r(1);
+    int r2 = jit::reg_r(2);
+    int r3 = jit::reg_r(3);
+    int imm = jit::SLJIT_IMM;
+    int mem = jit::SLJIT_MEM;
+    self.property_receiver(ins.b, ins.op == Opcode.GETTHISC);
+    e.op(jit::SLJIT_LSHR, r3, r0, 0, imm, 48);
+    guards.guard(jit::SLJIT_NOT_EQUAL, r3, 0, imm, (long)types::TAG_OBJECT, pc);
+    e.op(jit::SLJIT_AND, r0, r0, 0, imm, (long)types::NANBOX_PAYLOAD_MASK);
+    guards.guard(jit::SLJIT_EQUAL, r0, 0, imm, 0, pc);
+    HObject object;
+    ObjFlags forbidden;
+    forbidden.exotic_proxyobj = true;
+    forbidden.exotic_module_ns = true;
+    forbidden.exotic_deferred_ns = true;
+    forbidden.exotic_arguments = true;
+    forbidden.exotic_stringobj = true;
+    forbidden.exotic_array = true;
+    ObjFlags ordinary;
+    ordinary.obj_class = OBJECT;
+    e.mov(r3, 0, mem | r0, 0, jit::SLJIT_MOV_U32);
+    e.op(jit::SLJIT_AND, r3, r3, 0, imm, 0x003F0000U | (uint)forbidden);
+    guards.guard(jit::SLJIT_NOT_EQUAL, r3, 0, imm, (uint)ordinary, pc);
+    e.mov(r2, 0, imm, (long)ic);
+    e.mov(r3, 0, mem | r2, $reflect(ICEntry.chain_len).offset, jit::SLJIT_MOV_U8);
+    guards.guard(jit::SLJIT_NOT_EQUAL, r3, 0, imm, hobject::IC_CHAIN_POLY, pc);
+    e.mov(r2, 0, mem | r2, $reflect(ICEntry.chain).offset);
+    e.mov(r1, 0, mem | r0, (char*)&object.shape_id - (char*)&object, jit::SLJIT_MOV_U32);
+    ICPolySet layout;
+    void*[hobject::IC_POLY_MAX] hits;
+    for (uint i = 0; i < hobject::IC_POLY_MAX; i++) {
+        e.mov(r3, 0, mem | r2, $reflect(ICPolySet.count).offset, jit::SLJIT_MOV_U32);
+        guards.guard(jit::SLJIT_LESS_EQUAL, r3, 0, imm, i, pc);
+        e.mov(r3, 0, mem | r2, (char*)&layout.shapes[i] - (char*)&layout, jit::SLJIT_MOV_U32);
+        void* other = e.cmp(jit::SLJIT_NOT_EQUAL, r1, 0, r3, 0);
+        e.mov(r1, 0, mem | r2, (char*)&layout.prop_idx[i] - (char*)&layout, jit::SLJIT_MOV_U32);
+        hits[i] = jit::sljit_emit_jump(e.compiler, jit::SLJIT_JUMP);
+        e.bind(other);
+    }
+    guards.link(jit::sljit_emit_jump(e.compiler, jit::SLJIT_JUMP), pc, true);
+    void* found = e.label();
+    foreach (hit : hits) guards.bind_to(hit, found);
+    e.mov(r2, 0, mem | r0, (char*)&object.prop_alloc - (char*)&object);
+    void* allocated = e.cmp(jit::SLJIT_NOT_EQUAL, r2, 0, imm, 0);
+    e.op(jit::SLJIT_ADD, r2, r0, 0, imm, HObjectBase::size);
+    e.bind(allocated);
+    e.op(jit::SLJIT_SHL, r1, r1, 0, imm, 3);
+    e.op(jit::SLJIT_ADD, r2, r2, 0, r1, 0);
+    e.mov(r0, 0, mem | r2, 0);
+    function_store(&guards, ins.a, r0, pc);
+    $if $feat(SLJIT_STATS):
+        e.mov(r1, 0, imm, (long)&live_poly_hits);
+        e.mov(r2, 0, mem | r1, 0);
+        e.op(jit::SLJIT_ADD, r2, r2, 0, imm, 1);
+        e.mov(mem | r1, 0, r2, 0);
+    $endif
+    self.out.bind_to(jit::sljit_emit_jump(e.compiler, jit::SLJIT_JUMP), self.out.labels[pc + 1]);
+    void* failed = e.label();
+    for (uint i = 0; i < guards.link_count; i++) guards.bind_to(guards.link_at(i).jump, failed);
+    if (guards.e.failed) e.failed = true;
+}
