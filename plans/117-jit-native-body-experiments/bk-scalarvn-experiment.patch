 // SSA optimization and register allocation.
 
+// Scalar operations have no observable effects. A dominating evaluation of
+// identical SSA operands has already passed any representation/overflow guard.
+fn bool ssa_scalar_value(SsaOp op) @feat(SLJIT) {
+    switch (op) {
+        case CONST_I: case CONST_F:
+        case ADD: case SUB: case MUL: case DIV:
+        case BAND: case BOR: case BXOR: case SHL: case SHR: case USHR: case BNOT: case NEG:
+        case TO_INT: case TO_INDEX: case TO_F64: case BOX_I: case BOX_F: return true;
+        default: return false;
+    }
+}
+fn void ssa_replace_value(SsaGraph* g, uint index, int prior) @feat(SLJIT) {
+    SsaValue* value = &g.values[index];
+    value.op = COPY;
+    value.a = prior;
+    value.b = 0;
+    value.imm = 0;
+    if (g.values[prior].last < value.last) g.values[prior].last = value.last;
+}
