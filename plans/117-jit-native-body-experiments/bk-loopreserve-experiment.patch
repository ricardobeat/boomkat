diff --git a/src/vm/vm_sljit_budget.c3 b/src/vm/vm_sljit_budget.c3
index 7b999585..3375b3be 100644
--- a/src/vm/vm_sljit_budget.c3
+++ b/src/vm/vm_sljit_budget.c3
@@ -79,3 +79,12 @@ fn bool sljit_budget_reclaim(Heap* h, usz bytes) @feat(SLJIT) @noinline {
     if (reclaimed) sljit_budget_retry(h);
     return h.jit_code_bytes + bytes < sljit_code_limit(h);
 }
+
+// Experimental throughput reserve: baseline functions retain their existing
+// limit; only the optimizing loop tier may consume this additional space.
+fn bool sljit_loop_code_room(Heap* h, usz bytes, bool ssa) @feat(SLJIT) @inline {
+    $if $feat(SLJIT_LOOP_RESERVE):
+        if (ssa && h.jit_code_bytes + bytes < sljit_code_limit(h) + 256 * 1024) return true;
+    $endif
+    return sljit_code_room(h, bytes);
+}
