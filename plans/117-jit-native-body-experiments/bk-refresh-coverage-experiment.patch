diff --git a/src/vm/vm_sljit_feedback.c3 b/src/vm/vm_sljit_feedback.c3
new file mode 100644
--- /dev/null
+++ b/src/vm/vm_sljit_feedback.c3
@@ -0,0 +1,25 @@
+module boomkat::vm;
+
+import boomkat::bytecode;
+import boomkat::heap;
+import boomkat::hobject;
+
+// Refresh only when feedback gains receiver coverage. Mere shape/generation
+// churn is handled by ordinary invalidation and does not justify recompiling.
+fn uint sljit_read_coverage(CompiledFunction* cf) @feat(SLJIT) {
+    uint coverage;
+    for (uint pc = 0; pc < cf.code_count; pc++) {
+        if (!function_read_op(cf.code[pc].op)) continue;
+        ICEntry* ic = (ICEntry*)cf.ic_entries + pc;
+        if (ic.shape_id == heap::SHAPE_NONE || ic.key.borrow() == null) continue;
+        coverage++;
+        if (ic.chain_len == hobject::IC_CHAIN_POLY) coverage += ic.chain.poly.count;
+        if (ic.chain_len == hobject::IC_CHAIN_PROTO) coverage += ic.chain.proto.count;
+    }
+    return coverage;
+}
+
+fn bool sljit_read_feedback_changed(CompiledFunction* cf, FunctionPlan* plan) @feat(SLJIT) {
+    plan.read_misses = 0;
+    return sljit_read_coverage(cf) > plan.read_coverage;
+}
diff --git a/test/jit_read_refresh.js b/test/jit_read_refresh.js
new file mode 100644
--- /dev/null
+++ b/test/jit_read_refresh.js
@@ -0,0 +1,20 @@
+// Learn new receiver shapes after native code has already warmed, including
+// a linked caller. Refresh must preserve values and observable getter calls.
+function lateRead(o) { return o.value + 1; }
+function lateDrive(o) { return lateRead(o) + lateRead(o); }
+var shapes = [{value: 1}, {pad: 9, value: 2}, {other: 7, pad: 8, value: 3}];
+for (var phase = 0; phase < shapes.length; phase++) {
+    for (var i = 0; i < 1000; i++) {
+        if (lateDrive(shapes[phase]) !== (phase + 2) * 2) throw Error("late shape");
+    }
+}
+var count = 0;
+Object.defineProperty(shapes[1], "value", {get: function () {
+    count++;
+    return lateRead(shapes[0]);
+}});
+for (var j = 0; j < 1000; j++) {
+    if (lateDrive(shapes[1]) !== 6) throw Error("refresh accessor");
+}
+if (count !== 2000) throw Error("refresh effects");
+print("read refresh ok");
