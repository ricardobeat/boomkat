+
+// These producers always return a tagged integer after their guards succeed.
+fn bool function_integer_result(Instruction ins, FunctionFlow* flow) @feat(SLJIT) {
+    switch (ins.op) {
+        case LDINT: return true;
+        case LDREG: return flow.integer[ins.b];
+        case BAND: case BOR: case BXOR: case SHL: case SHR: case USHR: case BNOT:
+        case BANDI: case BORI: case BXORI: case SHLI: case SHRI: case USHRI: return true;
+        default: return false;
+    }
+}
