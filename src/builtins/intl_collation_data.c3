const usz INTL_COLLATION_BITMAPPED @feat(INTL_COLLATOR) = 38808;

// Primaries at or below this are variable: ignored by ignorePunctuation.
const ushort INTL_COLL_VARIABLE_TOP @feat(INTL_COLLATOR) = 0xBFF;
