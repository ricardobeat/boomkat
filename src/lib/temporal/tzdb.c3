// IANA tz database lookup. The compiled binary blob lives in
// tzdata_generated.c3 (generated by scripts/tzdata/build_tzdata.py from
// /var/db/timezone/zoneinfo or any directory of compiled TZif files).
//
// Public API:
//   - tzdb_offset_for_zone_at(zone_name, epoch_sec) -> offset_sec / -1 if not found
//   - tzdb_zone_exists(zone_name) -> bool
//   - tzdb_zone_index(zone_name) -> index into TZDB_ZONES, or -1 if absent
//
// Lookup is two binary searches:
//   1) find the zone in TZDB_ZONES (sorted by name) — O(log zone_count)
//   2) within that zone's transitions[], find the largest epoch_sec <= query
//
// The transitions array stores (epoch_sec, offset_sec) pairs sorted by
// epoch_sec. For an instant after the last transition, we return the
// last entry's offset (the zone's current offset). For an instant before
// the first transition (negative epoch), we return -1 — Temporal never
// needs pre-1970 lookups in practice, and the polyfill spec treats those
// as out-of-range.
module boomkat::lib::temporal;

import std::sort;

// TzdbTransition and TzdbZone structs live in tzdata_generated.c3 so the
// data declarations stay with the data.

// =============================================================================
// Internal helpers
// =============================================================================

// Binary-search the zone table by name. Returns the index if found, -1 if
// not. The macro is in std::sort; we use a manual loop here so the function
// inlines into a single cmp on names without a closure.
fn int tzdb_zone_index(String zone_name) {
    if (zone_name.len == 0) return -1;
    usz lo = 0;
    usz hi = TZDB_ZONES.len;
    while (lo < hi) {
        usz mid = lo + (hi - lo) / 2;
        int cmp = string_compare(TZDB_ZONES[mid].name, zone_name);
        if (cmp == 0) return (int)mid;
        if (cmp < 0) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

// String compare returning <0 / 0 / >0, matching std::sort's binarysearch
// convention. Both inputs are non-null String values.
fn int string_compare(String a, String b) {
    usz n = a.len < b.len ? a.len : b.len;
    for (usz i = 0; i < n; i++) {
        if (a[i] < b[i]) return -1;
        if (a[i] > b[i]) return 1;
    }
    if (a.len < b.len) return -1;
    if (a.len > b.len) return 1;
    return 0;
}

// Comparison fn for binarysearch over a zone's transitions: tzdb_transition
// is the array element (TzdbTransition), query is the target TzdbTransition
// the macro builds from the query epoch_sec. We compare epoch_sec fields.
fn int tzdb_transition_cmp(TzdbTransition a, TzdbTransition b) {
    if (a.epoch_sec < b.epoch_sec) return -1;
    if (a.epoch_sec > b.epoch_sec) return 1;
    return 0;
}

// =============================================================================
// Public API
// =============================================================================

// True if `zone_name` is a recognized IANA zone (matches one entry in the
// embedded tzdb).
fn bool tzdb_zone_exists(String zone_name) {
    return tzdb_zone_index(zone_name) >= 0;
}

// Returns the zone's offset from UTC (in seconds) at the given instant
// (Unix epoch seconds, UTC). Returns 0 if the zone is not recognized —
// the spec says throw RangeError, but the engine callers will validate
// the name first; the 0 fallback is for "UTC" itself and any aliased zone
// we haven't cataloged.
//
// For instants before the first transition (negative epoch), returns
// initial_offset_sec, which is the zone's pre-history offset. Temporal
// only ever queries instants >= 0 in practice.
fn int tzdb_offset_for_zone_at(String zone_name, long epoch_sec) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return 0;
    TzdbZone* z = &TZDB_ZONES[idx];
    TzdbTransition[] trans = z.transitions;
    if (trans.len == 0) return z.initial_offset_sec;
    TzdbTransition key = { .epoch_sec = epoch_sec, .offset_sec = 0 };
    usz pos = (usz)std::sort::binarysearch(trans, key, &tzdb_transition_cmp);
    if (pos >= trans.len) {
        // Past the last transition; current offset is the last entry's
        return trans[trans.len - 1].offset_sec;
    }
    if (trans[pos].epoch_sec == epoch_sec) return trans[pos].offset_sec;
    if (pos == 0) {
        // Query is before the first transition; return the initial offset
        // (the zone's offset as of "time immemorial" in the IANA model).
        return z.initial_offset_sec;
    }
    return trans[pos - 1].offset_sec;
}

// The zone's offset (in seconds) that applied before its first recorded
// transition. 0 if the zone is unknown.
fn int tzdb_zone_initial_offset(String zone_name) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return 0;
    return TZDB_ZONES[idx].initial_offset_sec;
}

// The zone's sorted transition list (epoch_sec, offset_sec) pairs. Returns an
// empty array if the zone is unknown. Consecutive same-offset entries
// (abbreviation-only changes in the source tzdata) can occur; callers that
// need "offset actually changed" semantics must collapse them.
fn TzdbTransition[] tzdb_zone_transitions(String zone_name) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return {};
    return TZDB_ZONES[idx].transitions;
}
