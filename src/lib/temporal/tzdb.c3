// IANA tz database lookup. The compiled binary blob lives in
// tzdata_generated.c3 (generated by scripts/tzdata/build_tzdata.py from
// /var/db/timezone/zoneinfo or any directory of compiled TZif files).
//
// The transition tables ship deflate-compressed (TZDB_BLOB) and are decoded
// once, lazily, on the first lookup — storing them raw cost ~272 KB of binary
// versus ~10 KB compressed. After decoding, every zone's transitions live in
// one contiguous heap pool and each zone holds a slice into it, so lookup is
// the same two binary searches as before.
//
// Public API:
//   - tzdb_offset_for_zone_at(zone_name, epoch_sec) -> offset_sec / -1 if not found
//   - tzdb_zone_exists(zone_name) -> bool
//   - tzdb_zone_index(zone_name) -> index into TZDB_ZONES, or -1 if absent
//
// Lookup is two binary searches:
//   1) find the zone in TZDB_ZONES (sorted by name) — O(log zone_count)
//   2) within that zone's transitions[], find the largest epoch_sec <= query
//
// The transitions array stores (epoch_sec, offset_sec) pairs sorted by
// epoch_sec. For an instant after the last transition, we return the
// last entry's offset (the zone's current offset). For an instant before
// the first transition (negative epoch), we return -1 — Temporal never
// needs pre-1970 lookups in practice, and the polyfill spec treats those
// as out-of-range.
module boomkat::lib::temporal;

import std::sort;
import std::compression::deflate;

// TzdbTransition and TzdbZone structs live in tzdata_generated.c3 so the
// data declarations stay with the data.

// =============================================================================
// Lazy blob decoding
// =============================================================================

// All transitions, concatenated in table order. Allocated once by
// tzdb_ensure_loaded and never freed — the tzdb lives for the process.
TzdbTransition* g_tzdb_pool @private = null;
// Start index into g_tzdb_pool for each table, plus a terminator at
// [TZDB_TABLE_COUNT] so table i spans [starts[i], starts[i+1]).
usz* g_tzdb_table_start @private = null;
bool g_tzdb_loaded @private = false;

// Read an unsigned LEB128 varint from `buf` at `*pos`, advancing `*pos`.
fn ulong tzdb_read_varint(char[] buf, usz* pos) @private {
    ulong result = 0;
    uint shift = 0;
    while (*pos < buf.len) {
        char b = buf[*pos];
        (*pos)++;
        result |= ((ulong)(b & 0x7F)) << shift;
        if ((b & 0x80) == 0) break;
        shift += 7;
    }
    return result;
}

// Zigzag-decode: the encoder maps signed values so small magnitudes of either
// sign stay short.
fn long tzdb_zigzag_decode(ulong v) @private {
    return (long)(v >> 1) ^ -((long)(v & 1));
}

// Decode TZDB_BLOB into g_tzdb_pool / g_tzdb_table_start. Called once, guarded
// by g_tzdb_loaded. See encode_blob() in scripts/tzdata/build_tzdata.py for the
// wire format; the two must change together.
fn void tzdb_ensure_loaded() @private {
    if (g_tzdb_loaded) return;
    g_tzdb_loaded = true;

    // A corrupt or truncated blob is a build error, not a runtime condition:
    // the data is baked into the binary by the generator. Leaving the pool
    // null degrades every lookup to "zone not found" rather than crashing.
    char[] raw = deflate::decompress(mem, TZDB_BLOB[..]) ?? {};
    if (raw.len == 0) return;

    usz pos = 0;

    // Offset table: the whole tzdb uses only ~68 distinct UTC offsets, so
    // transitions store an index into this instead of a full int.
    usz n_offsets = (usz)tzdb_read_varint(raw, &pos);
    int[] offsets = alloc::alloc_array_try(mem, int, (sz)n_offsets) ?? {};
    if (offsets.len != n_offsets) return;
    for (usz i = 0; i < n_offsets; i++) {
        offsets[i] = (int)tzdb_zigzag_decode(tzdb_read_varint(raw, &pos));
    }

    usz n_tables = (usz)tzdb_read_varint(raw, &pos);
    if (n_tables != TZDB_TABLE_COUNT) return;

    usz[] starts = alloc::alloc_array_try(mem, usz, (sz)(n_tables + 1)) ?? {};
    TzdbTransition[] pool = alloc::alloc_array_try(mem, TzdbTransition, (sz)TZDB_TRANSITION_COUNT) ?? {};
    if (starts.len != n_tables + 1 || pool.len != TZDB_TRANSITION_COUNT) return;

    usz write = 0;
    for (usz t = 0; t < n_tables; t++) {
        starts[t] = write;
        usz count = (usz)tzdb_read_varint(raw, &pos);
        long epoch = 0;
        for (usz k = 0; k < count; k++) {
            // Epochs are delta-encoded against the previous entry; transitions
            // are sorted ascending, so the deltas stay small.
            epoch += tzdb_zigzag_decode(tzdb_read_varint(raw, &pos));
            usz oi = (usz)tzdb_read_varint(raw, &pos);
            if (write >= TZDB_TRANSITION_COUNT || oi >= n_offsets) return;
            pool[write].epoch_sec = epoch;
            pool[write].offset_sec = offsets[oi];
            write++;
        }
    }
    starts[n_tables] = write;

    g_tzdb_table_start = starts.ptr;
    g_tzdb_pool = pool.ptr;
}

// The decoded transition slice for a zone table index, or empty if the blob
// failed to decode.
fn TzdbTransition[] tzdb_table(int table_idx) @private {
    tzdb_ensure_loaded();
    if (g_tzdb_pool == null || table_idx < 0) return {};
    usz i = (usz)table_idx;
    if (i >= TZDB_TABLE_COUNT) return {};
    usz start = g_tzdb_table_start[i];
    usz end = g_tzdb_table_start[i + 1];
    // `..` is inclusive, so guard the empty case rather than underflowing on
    // end - 1. The generator always emits at least one entry per table, but
    // the decoder shouldn't depend on that.
    if (end <= start) return {};
    return g_tzdb_pool[start..end - 1];
}

// =============================================================================
// Internal helpers
// =============================================================================

// Binary-search the zone table by name. Returns the index if found, -1 if
// not. The macro is in std::sort; we use a manual loop here so the function
// inlines into a single cmp on names without a closure.
fn int tzdb_zone_index(String zone_name) {
    if (zone_name.len == 0) return -1;
    usz lo = 0;
    usz hi = TZDB_ZONES.len;
    while (lo < hi) {
        usz mid = lo + (hi - lo) / 2;
        int cmp = string_compare(TZDB_ZONES[mid].name, zone_name);
        if (cmp == 0) return (int)mid;
        if (cmp < 0) {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return -1;
}

// String compare returning <0 / 0 / >0, matching std::sort's binarysearch
// convention. Both inputs are non-null String values.
fn int string_compare(String a, String b) {
    usz n = a.len < b.len ? a.len : b.len;
    for (usz i = 0; i < n; i++) {
        if (a[i] < b[i]) return -1;
        if (a[i] > b[i]) return 1;
    }
    if (a.len < b.len) return -1;
    if (a.len > b.len) return 1;
    return 0;
}

// Comparison fn for binarysearch over a zone's transitions: tzdb_transition
// is the array element (TzdbTransition), query is the target TzdbTransition
// the macro builds from the query epoch_sec. We compare epoch_sec fields.
fn int tzdb_transition_cmp(TzdbTransition a, TzdbTransition b) {
    if (a.epoch_sec < b.epoch_sec) return -1;
    if (a.epoch_sec > b.epoch_sec) return 1;
    return 0;
}

// =============================================================================
// Public API
// =============================================================================

// True if `zone_name` is a recognized IANA zone (matches one entry in the
// embedded tzdb).
fn bool tzdb_zone_exists(String zone_name) {
    return tzdb_zone_index(zone_name) >= 0;
}

// Case-insensitive zone existence check, used by the ZDT property-bag path
// where the spec allows "utC" / "America/NEW_YORK" to match canonical
// "UTC" / "America/New_York". The canonical name is written into
// `canonical_buf` so the caller can attach it to the resulting ZDT.
fn bool tzdb_zone_exists_ci(String zone_name, char* canonical_buf, usz buf_cap) {
    int idx = tzdb_zone_index(zone_name);
    if (idx >= 0) {
        if (canonical_buf != null && buf_cap > 0) {
            String canon = TZDB_ZONES[idx].name;
            usz n = canon.len < (buf_cap - 1) ? canon.len : (buf_cap - 1);
            for (usz k = 0; k < n; k++) canonical_buf[k] = canon[k];
            canonical_buf[n] = 0;
        }
        return true;
    }
    for (usz k = 0; k < TZDB_ZONES.len; k++) {
        String cand = TZDB_ZONES[k].name;
        if (ci_zone_eq(zone_name, cand)) {
            if (canonical_buf != null && buf_cap > 0) {
                usz n = cand.len < (buf_cap - 1) ? cand.len : (buf_cap - 1);
                for (usz j = 0; j < n; j++) canonical_buf[j] = cand[j];
                canonical_buf[n] = 0;
            }
            return true;
        }
    }
    return false;
}

// ASCII case-insensitive zone-name comparison.
fn bool ci_zone_eq(String a, String b) {
    if (a.len != b.len) return false;
    for (usz k = 0; k < a.len; k++) {
        char ca = a[k];
        char cb = b[k];
        if (ca >= 'A' && ca <= 'Z') ca = (char)(ca + 32);
        if (cb >= 'A' && cb <= 'Z') cb = (char)(cb + 32);
        if (ca != cb) return false;
    }
    return true;
}

// Convenience wrapper: returns the offset (in seconds) of the case-folded
// zone at `epoch_sec`, or -1 if unknown. Used by Temporal.Now so that an
// upper- or mixed-case zone string ("Utc", "AMERICA/new_york") resolves to
// the canonical tzdb entry. The canonical name is written into `canonical_buf`
// for the caller to attach to the resulting ZDT (so `timeZoneId` reports the
// canonical spelling).
fn int tzdb_offset_for_zone_ci(String zone_name, long epoch_sec, char* canonical_buf, usz buf_cap) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) {
        // Find a case-fold match.
        for (usz k = 0; k < TZDB_ZONES.len; k++) {
            String cand = TZDB_ZONES[k].name;
            if (cand.len != zone_name.len) continue;
            bool match = true;
            for (usz i = 0; i < cand.len; i++) {
                char a = cand[i];
                char b = zone_name[i];
                if (a >= 'A' && a <= 'Z') a = (char)(a + 32);
                if (b >= 'A' && b <= 'Z') b = (char)(b + 32);
                if (a != b) { match = false; break; }
            }
            if (match) { idx = (int)k; break; }
        }
    }
    if (idx < 0) return -1;
    String canon = TZDB_ZONES[idx].name;
    if (canonical_buf != null && buf_cap > 0) {
        usz n = canon.len < buf_cap ? canon.len : buf_cap;
        for (usz i = 0; i < n; i++) canonical_buf[i] = canon[i];
    }
    return tzdb_offset_for_zone_at(canon, epoch_sec);
}

// Returns the zone's offset from UTC (in seconds) at the given instant
// (Unix epoch seconds, UTC). Returns 0 if the zone is not recognized —
// the spec says throw RangeError, but the engine callers will validate
// the name first; the 0 fallback is for "UTC" itself and any aliased zone
// we haven't cataloged.
//
// For instants before the first transition (negative epoch), returns
// initial_offset_sec, which is the zone's pre-history offset. Temporal
// only ever queries instants >= 0 in practice.
fn int tzdb_offset_for_zone_at(String zone_name, long epoch_sec) {
    // Fixed-offset time zones: Z or ±HH[:MM].
    if (zone_name.len > 0) {
        char first = zone_name.ptr[0];
        if (first == 'Z' || first == 'z') return 0;
        if (first == '+' || first == '-') {
            bool neg = (first == '-');
            int h = 0;
            int mi = 0;
            if (zone_name.len >= 3) {
                h = (zone_name.ptr[1] - '0') * 10 + (zone_name.ptr[2] - '0');
            }
            if (zone_name.len >= 5 && zone_name.ptr[3] == ':') {
                mi = (zone_name.ptr[4] - '0') * 10 + (zone_name.ptr[5] - '0');
            }
            int off = h * 3600 + mi * 60;
            return neg ? -off : off;
        }
    }
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return 0;
    TzdbZone* z = &TZDB_ZONES[idx];
    TzdbTransition[] trans = tzdb_table(z.table_idx);
    if (trans.len == 0) return z.initial_offset_sec;
    TzdbTransition key = { .epoch_sec = epoch_sec, .offset_sec = 0 };
    usz pos = (usz)std::sort::binarysearch(trans, key, &tzdb_transition_cmp);
    if (pos >= trans.len) {
        // Past the last transition; current offset is the last entry's
        return trans[trans.len - 1].offset_sec;
    }
    if (trans[pos].epoch_sec == epoch_sec) return trans[pos].offset_sec;
    if (pos == 0) {
        // Query is before the first transition; return the initial offset
        // (the zone's offset as of "time immemorial" in the IANA model).
        return z.initial_offset_sec;
    }
    return trans[pos - 1].offset_sec;
}

// The zone's offset (in seconds) that applied before its first recorded
// transition. 0 if the zone is unknown.
fn int tzdb_zone_initial_offset(String zone_name) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return 0;
    return TZDB_ZONES[idx].initial_offset_sec;
}

// The zone's sorted transition list (epoch_sec, offset_sec) pairs. Returns an
// empty array if the zone is unknown. Consecutive same-offset entries
// (abbreviation-only changes in the source tzdata) can occur; callers that
// need "offset actually changed" semantics must collapse them.
fn TzdbTransition[] tzdb_zone_transitions(String zone_name) {
    int idx = tzdb_zone_index(zone_name);
    if (idx < 0) return {};
    return tzdb_table(TZDB_ZONES[idx].table_idx);
}
