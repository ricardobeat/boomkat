{
  "langrev": "1",
  "warnings": [ "all" ],
  "targets": {
    "lib": {
      "type": "static-lib",
      "sources": [ "src", "regexp" ],
      "opt": "Os"
    },
    "tinyduck": {
      "type": "executable",
      "sources": [ "src", "regexp", "cli/main.c3" ],
      "features": [ "NO_REGEXP" ],
      "opt": "Oz",
      "single-module": true,
      "strip-unused": true
    },
    "tinyduck_test": {
      "type": "executable",
      "sources": [ "src", "regexp", "test_vm_runner/test_vm.c3" ],
      "opt": "Oz",
      "single-module": true,
      "strip-unused": true
    },
    "tinyduck_test_noregexp": {
      "type": "executable",
      "sources": [ "src", "regexp", "test_vm_runner/test_vm.c3" ],
      "features": [ "NO_REGEXP" ],
      "opt": "Oz",
      "single-module": true,
      "strip-unused": true
    },
    "tinyduck_cli": {
      "type": "executable",
      "sources": [ "src", "regexp", "cli/main.c3" ],
      "opt": "Oz",
      "single-module": true,
      "strip-unused": true
    },

    // -- Debug targets (excluded from release builds) ---------------------------

    "tinyduck_debug": {
      "type": "executable",
      "sources": [ "src", "regexp", "cli/main.c3" ],
      "features": [ "NO_REGEXP", "DEBUG" ],
      "single-module": true
    },
    "tinyduck_test_debug": {
      "type": "executable",
      "sources": [ "src", "regexp", "test_vm_runner/test_vm.c3" ],
      "features": [ "DEBUG" ],
      "single-module": true
    }
  }
}
