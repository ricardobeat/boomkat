+enum BuiltinStr : uint {
+    UNDEFINED,   // "undefined"
+    OBJECT,      // "object"
+    BOOLEAN,     // "boolean"
+    NUMBER,      // "number"
+    STRING,      // "string"
+    FUNCTION,    // "function"
+    TRUE,        // "true"
