+if ("Hello World".toLowerCase() === "hello world") { pass = pass + 1; } else { print("FAIL: toLowerCase Hello World"); fail = fail + 1; }
+if ("ABC123".toLowerCase() === "abc123") { pass = pass + 1; } else { print("FAIL: toLowerCase ABC123"); fail = fail + 1; }
