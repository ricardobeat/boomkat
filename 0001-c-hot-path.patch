diff --git a/benchmarks/vm_dispatch_bench.c3 b/benchmarks/vm_dispatch_bench.c3
new file mode 100644
index 0000000..fc4182f
--- /dev/null
+++ b/benchmarks/vm_dispatch_bench.c3
@@ -0,0 +1,293 @@
+/// VM dispatch benchmark — compares three dispatch strategies:
+///
+///   1. Baseline:  plain C3 switch
+///   2. Call threading:  function-pointer dispatch table
+///   3. C computed goto:  C function using GCC/Clang labels-as-values
+///
+/// Each strategy executes the *same* straight-line bytecode program
+/// (mixed arithmetic + loads) ITERATIONS times.  The final accumulator
+/// is summed across runs and printed so the compiler cannot eliminate
+/// the work.
+module vm_dispatch_bench;
+
+import std::io;
+import libc;
+
+// ============================================================================
+// Constants
+// ============================================================================
+const int CLOCK_MONOTONIC = 6;  // macOS value (not 1)
+
+struct Timespec { long tv_sec; long tv_nsec; }
+extern fn int clock_gettime(int, Timespec*);
+
+const uint NUM_REGS      =   32;
+const uint CODE_SIZE     = 8192;
+const uint PROGRAM_SIZE  = 4000;   // instructions in generated program
+const uint WARMUP        = 1000;
+const uint ITERATIONS    = 100000;  // measurement iterations
+
+// ============================================================================
+// Minimal opcode set (MUST stay in sync with C opcode enum)
+// ============================================================================
+enum Op : char {
+    BENCH_NOP,
+    BENCH_LOAD_IMM,
+    BENCH_ADD,
+    BENCH_SUB,
+    BENCH_MUL,
+    BENCH_END,
+}
+
+const uint OP_COUNT = 6;
+
+// ============================================================================
+// Instruction encoding (32-bit, matches C bit layout)
+//   op : bits 0-7, a : bits 8-15, b : bits 16-23, c : bits 24-31
+// ============================================================================
+bitstruct Insn : uint {
+    Op  op : 0..7;
+    uint a : 8..15;
+    uint b : 16..23;
+    uint c : 24..31;
+}
+
+fn Insn make_insn(Op op, uint a, uint b, uint c) {
+    Insn r;
+    r.op = op;
+    r.a  = a & 0xFF;
+    r.b  = b & 0xFF;
+    r.c  = c & 0xFF;
+    return r;
+}
+
+fn uint get_bc(Insn insn) => ((uint)insn.c << 8) | (uint)insn.b;
+
+// ============================================================================
+// VM state
+// ============================================================================
+struct BenchState {
+    long[NUM_REGS] regs;
+    Insn[CODE_SIZE] code;
+    uint code_len;
+}
+
+// ============================================================================
+// Program builder — straight-line mixed-opcode sequence
+// ============================================================================
+fn void build_program(BenchState* s) {
+    uint idx = 0;
+
+    // Initialise first 8 registers with known constants
+    for (uint i = 0; i < 8 && idx < PROGRAM_SIZE; i++) {
+        s.code[idx] = make_insn(BENCH_LOAD_IMM, i, (i * 3) & 0xFF, 0);
+        idx++;
+    }
+
+    // Bulk: pattern of ADD / SUB / MUL with occasional NOP
+    while (idx < PROGRAM_SIZE - 2) {
+        uint dst  = (idx)      % 8;
+        uint src1 = (idx + 1)  % 8;
+        uint src2 = (idx + 2)  % 8;
+
+        Op op;
+        switch (idx % 3) {
+            case 0: op = BENCH_ADD; break;
+            case 1: op = BENCH_SUB; break;
+            default: op = BENCH_MUL; break;
+        }
+
+        s.code[idx] = make_insn(op, dst, src1, src2);
+        idx++;
+
+        // ~14 % NOPs
+        if (idx % 7 == 0 && idx < PROGRAM_SIZE - 2) {
+            s.code[idx] = make_insn(BENCH_NOP, 0, 0, 0);
+            idx++;
+        }
+    }
+
+    s.code[idx] = make_insn(BENCH_END, 0, 0, 0);
+    idx++;
+    s.code_len = idx;
+}
+
+// ============================================================================
+// Timing helper — returns nanoseconds since boot
+// ============================================================================
+fn long now_ns() {
+    Timespec ts;
+    int rc = clock_gettime(CLOCK_MONOTONIC, &ts);
+    if (rc != 0) {
+        io::eprintfn("clock_gettime failed");
+    }
+    return ts.tv_sec * 1000000000L + ts.tv_nsec;
+}
+
+// ============================================================================
+// Approach 1 — Baseline: plain switch
+// ============================================================================
+fn long run_switch(BenchState* s) {
+    for (uint i = 0; i < NUM_REGS; i++) s.regs[i] = 0;
+
+    uint pc = 0;
+    while (pc < s.code_len) {
+        Insn insn = s.code[pc];
+        switch (insn.op) {
+        case BENCH_NOP:
+            break;
+
+        case BENCH_LOAD_IMM:
+            s.regs[insn.a] = (long)get_bc(insn);
+            break;
+
+        case BENCH_ADD:
+            s.regs[insn.a] = s.regs[insn.b] + s.regs[insn.c];
+            break;
+
+        case BENCH_SUB:
+            s.regs[insn.a] = s.regs[insn.b] - s.regs[insn.c];
+            break;
+
+        case BENCH_MUL:
+            s.regs[insn.a] = s.regs[insn.b] * s.regs[insn.c];
+            break;
+
+        case BENCH_END:
+            return s.regs[0];
+        }
+        pc++;
+    }
+    return s.regs[0];
+}
+
+// ============================================================================
+// Approach 2 — Call threading: function-pointer dispatch
+// ============================================================================
+alias OpHandler = fn void(long* regs, uint a, uint b, uint c);
+
+fn void op_nop(long* regs, uint a, uint b, uint c) {}
+fn void op_load_imm(long* regs, uint a, uint b, uint c) { regs[a] = (long)((c << 8) | b); }
+fn void op_add(long* regs, uint a, uint b, uint c)      { regs[a] = regs[b] + regs[c]; }
+fn void op_sub(long* regs, uint a, uint b, uint c)      { regs[a] = regs[b] - regs[c]; }
+fn void op_mul(long* regs, uint a, uint b, uint c)      { regs[a] = regs[b] * regs[c]; }
+fn void op_end(long* regs, uint a, uint b, uint c)      {}
+
+fn long run_call_threading(BenchState* s) {
+    OpHandler[OP_COUNT] handlers = {
+        &op_nop,
+        &op_load_imm,
+        &op_add,
+        &op_sub,
+        &op_mul,
+        &op_end,
+    };
+
+    for (uint i = 0; i < NUM_REGS; i++) s.regs[i] = 0;
+
+    uint pc = 0;
+    while (pc < s.code_len) {
+        Insn insn = s.code[pc];
+        handlers[(uint)insn.op](&s.regs, insn.a, insn.b, insn.c);
+        if (insn.op == BENCH_END) break;
+        pc++;
+    }
+    return s.regs[0];
+}
+
+// ============================================================================
+// Approach 3 — C computed goto (via C interop)
+// ============================================================================
+extern fn long vm_dispatch_c(uint* code, uint code_len,
+                             long* regs, uint num_regs);
+
+fn long run_c_computed_goto(BenchState* s) {
+    for (uint i = 0; i < NUM_REGS; i++) s.regs[i] = 0;
+    return vm_dispatch_c((uint*)&s.code, s.code_len, &s.regs, NUM_REGS);
+}
+
+// ============================================================================
+// Approach 4 — C plain switch (via C interop, to isolate boundary overhead)
+// ============================================================================
+extern fn long vm_dispatch_c_switch(uint* code, uint code_len,
+                                    long* regs, uint num_regs);
+
+fn long run_c_switch(BenchState* s) {
+    for (uint i = 0; i < NUM_REGS; i++) s.regs[i] = 0;
+    return vm_dispatch_c_switch((uint*)&s.code, s.code_len, &s.regs, NUM_REGS);
+}
+
+// ============================================================================
+// Main
+// ============================================================================
+fn int main(String[] args) {
+    BenchState s;
+    build_program(&s);
+
+    io::printfn("VM Dispatch Benchmark");
+    io::printfn("  Program size:  %d instructions",   s.code_len);
+    io::printfn("  Iterations:    %d",                ITERATIONS);
+    io::printfn("  Total dispatches: %d",             s.code_len * ITERATIONS);
+    io::printfn("");
+
+    // ---- 1. Baseline: C3 switch ----
+    for (uint i = 0; i < WARMUP; i++) run_switch(&s);
+    long t0 = now_ns();
+    long r1 = 0;
+    for (uint i = 0; i < ITERATIONS; i++) r1 += run_switch(&s);
+    long t1 = now_ns();
+    io::printfn("  1. C3 switch                %8.3f s    (guard=%d)",
+                (double)(t1 - t0) * 1.0e-9, r1);
+
+    // ---- 2. C3 call threading (fn ptr) ----
+    for (uint i = 0; i < WARMUP; i++) run_call_threading(&s);
+    long t2 = now_ns();
+    long r2 = 0;
+    for (uint i = 0; i < ITERATIONS; i++) r2 += run_call_threading(&s);
+    long t3 = now_ns();
+    io::printfn("  2. C3 call threading (fn)    %8.3f s    (guard=%d)",
+                (double)(t3 - t2) * 1.0e-9, r2);
+
+    // ---- 3. C computed goto ----
+    for (uint i = 0; i < WARMUP; i++) run_c_computed_goto(&s);
+    long t4 = now_ns();
+    long r3 = 0;
+    for (uint i = 0; i < ITERATIONS; i++) r3 += run_c_computed_goto(&s);
+    long t5 = now_ns();
+    io::printfn("  3. C computed goto          %8.3f s    (guard=%d)",
+                (double)(t5 - t4) * 1.0e-9, r3);
+
+    // ---- 4. C switch (interop overhead control) ----
+    for (uint i = 0; i < WARMUP; i++) run_c_switch(&s);
+    long t6 = now_ns();
+    long r4 = 0;
+    for (uint i = 0; i < ITERATIONS; i++) r4 += run_c_switch(&s);
+    long t7 = now_ns();
+    io::printfn("  4. C switch (interop)       %8.3f s    (guard=%d)",
+                (double)(t7 - t6) * 1.0e-9, r4);
+
+    // ---- Relative ratios ----
+    double t_c3_switch   = (double)(t1 - t0);
+    double t_call_thread = (double)(t3 - t2);
+    double t_cgoto       = (double)(t5 - t4);
+    double t_c_switch    = (double)(t7 - t6);
+
+    io::printfn("");
+    io::printfn("--- Relative to C3 switch (1.0) ---");
+    io::printfn("  call threading          %.2f×",  t_call_thread / t_c3_switch);
+    io::printfn("  C computed goto          %.2f×",  t_cgoto       / t_c3_switch);
+    io::printfn("  C switch (interop)       %.2f×",  t_c_switch    / t_c3_switch);
+    io::printfn("");
+    io::printfn("--- C internal: computed goto vs C switch ---");
+    io::printfn("  C computed goto / C switch:  %.2f×", t_cgoto / t_c_switch);
+
+    // Sanity: all four must produce the same guard sum
+    if (r1 == r2 && r2 == r3 && r3 == r4) {
+        io::printfn("[OK] All results match: %d", r1);
+    } else {
+        io::printfn("[MISMATCH] c3=%d  fn=%d  cgoto=%d  csw=%d", r1, r2, r3, r4);
+        return 1;
+    }
+
+    return 0;
+}
diff --git a/benchmarks/vm_dispatch_c.c b/benchmarks/vm_dispatch_c.c
new file mode 100644
index 0000000..6f9698b
--- /dev/null
+++ b/benchmarks/vm_dispatch_c.c
@@ -0,0 +1,99 @@
+/// C dispatch variants — computed goto and plain switch.
+/// Opcode and instruction encoding must match vm_dispatch_bench.c3:
+///   op : bits 0-7, a : bits 8-15, b : bits 16-23, c : bits 24-31
+///   get_bc = (c << 8) | b = bits 16-31
+#include <stdint.h>
+
+enum { BENCH_NOP, BENCH_LOAD_IMM, BENCH_ADD, BENCH_SUB, BENCH_MUL, BENCH_END };
+
+static inline uint32_t get_a(uint32_t insn) { return (insn >> 8) & 0xFF; }
+static inline uint32_t get_b(uint32_t insn) { return (insn >> 16) & 0xFF; }
+static inline uint32_t get_c(uint32_t insn) { return (insn >> 24); }
+static inline uint32_t get_bc(uint32_t insn) { return (insn >> 16); }
+
+// ------------------------------------------------------------------
+// VERSION A — computed-goto dispatch (labels-as-values extension)
+// ------------------------------------------------------------------
+int64_t vm_dispatch_c(const uint32_t* code, uint32_t code_len,
+                      int64_t* regs, uint32_t num_regs) {
+    uint32_t pc = 0;
+
+    const void* targets[] = {
+        &&L_NOP, &&L_LOAD_IMM, &&L_ADD, &&L_SUB,
+        &&L_MUL, &&L_END
+    };
+
+    goto *targets[code[pc] & 0xFF];
+
+L_NOP:
+    pc++;
+    goto *targets[code[pc] & 0xFF];
+
+L_LOAD_IMM: {
+    uint32_t insn = code[pc];
+    regs[get_a(insn)] = (int64_t)get_bc(insn);
+    pc++;
+    goto *targets[code[pc] & 0xFF];
+}
+
+L_ADD: {
+    uint32_t insn = code[pc];
+    regs[get_a(insn)] = regs[get_b(insn)] + regs[get_c(insn)];
+    pc++;
+    goto *targets[code[pc] & 0xFF];
+}
+
+L_SUB: {
+    uint32_t insn = code[pc];
+    regs[get_a(insn)] = regs[get_b(insn)] - regs[get_c(insn)];
+    pc++;
+    goto *targets[code[pc] & 0xFF];
+}
+
+L_MUL: {
+    uint32_t insn = code[pc];
+    regs[get_a(insn)] = regs[get_b(insn)] * regs[get_c(insn)];
+    pc++;
+    goto *targets[code[pc] & 0xFF];
+}
+
+L_END:
+    return regs[0];
+}
+
+// ------------------------------------------------------------------
+// VERSION B — plain C switch  (same logic, isolates C3-C boundary cost)
+// ------------------------------------------------------------------
+int64_t vm_dispatch_c_switch(const uint32_t* code, uint32_t code_len,
+                             int64_t* regs, uint32_t num_regs) {
+    uint32_t pc = 0;
+
+    while (pc < code_len) {
+        uint32_t insn = code[pc];
+        switch (insn & 0xFF) {
+        case BENCH_NOP:
+            break;
+
+        case BENCH_LOAD_IMM:
+            regs[get_a(insn)] = (int64_t)get_bc(insn);
+            break;
+
+        case BENCH_ADD:
+            regs[get_a(insn)] = regs[get_b(insn)] + regs[get_c(insn)];
+            break;
+
+        case BENCH_SUB:
+            regs[get_a(insn)] = regs[get_b(insn)] - regs[get_c(insn)];
+            break;
+
+        case BENCH_MUL:
+            regs[get_a(insn)] = regs[get_b(insn)] * regs[get_c(insn)];
+            break;
+
+        case BENCH_END:
+            return regs[0];
+        }
+        pc++;
+    }
+    return regs[0];
+}
diff --git a/duktape_cmdline.c b/duktape_cmdline.c
new file mode 100644
index 0000000..540ddfc
--- /dev/null
+++ b/duktape_cmdline.c
@@ -0,0 +1,71 @@
+/* Minimal Duktape v2.7.0 command-line runner for benchmarks */
+#include <stdio.h>
+#include <stdlib.h>
+#include "duktape/src-separate/duk_config.h"
+#include "duktape/src-separate/duktape.h"
+
+static char *read_file(const char *path, size_t *out_size) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    fseek(f, 0, SEEK_END);
+    long sz = ftell(f);
+    fseek(f, 0, SEEK_SET);
+    char *buf = malloc(sz + 1);
+    if (!buf) { fclose(f); return NULL; }
+    fread(buf, 1, (size_t)sz, f);
+    buf[sz] = '\0';
+    fclose(f);
+    *out_size = (size_t)sz;
+    return buf;
+}
+
+/* Global print() — matches Duktape default builtin */
+static int duk_bi_global_print(duk_context *ctx) {
+    duk_idx_t nargs = duk_get_top(ctx);
+    for (duk_idx_t i = 0; i < nargs; i++) {
+        if (i > 0) putchar(' ');
+        const char *s = duk_to_string(ctx, i);
+        if (s) fputs(s, stdout);
+    }
+    putchar('\n');
+    fflush(stdout);
+    return 1;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) {
+        fprintf(stderr, "Usage: %s <file.js>\n", argv[0]);
+        return 1;
+    }
+
+    duk_context *ctx = duk_create_heap_default();
+    if (!ctx) {
+        fprintf(stderr, "Failed to create Duktape context\n");
+        return 1;
+    }
+
+    /* Add print() builtin */
+    duk_push_c_function(ctx, duk_bi_global_print, DUK_VARARGS);
+    duk_put_global_string(ctx, "print");
+
+    size_t sz = 0;
+    char *src = read_file(argv[1], &sz);
+    if (!src) {
+        fprintf(stderr, "Cannot open file: %s\n", argv[1]);
+        duk_destroy_heap(ctx);
+        return 1;
+    }
+
+    int rc = duk_peval_lstring(ctx, src, sz);
+    free(src);
+    if (rc != 0) {
+        fprintf(stderr, "eval failed: %s\n", duk_safe_to_string(ctx, -1));
+        duk_pop(ctx);
+        duk_destroy_heap(ctx);
+        return 1;
+    }
+    duk_pop(ctx); /* pop result */
+
+    duk_destroy_heap(ctx);
+    return 0;
+}
diff --git a/justfile b/justfile
new file mode 100644
index 0000000..a820c0d
--- /dev/null
+++ b/justfile
@@ -0,0 +1,107 @@
+# Duktape C3 Port — common tasks
+justfile := "benchmarks/README.md"
+
+# ── Build ────────────────────────────────────────────────────────────────────
+
+# Build everything (default)
+all: build-lib build-vm build-batch build-bench build-orig-duktape
+
+# Build the static library
+build-lib:
+    c3c build duktape
+
+# Build the single-file test runner
+build-vm:
+    c3c build test_vm
+
+# Build the batch test262 runner
+build-batch:
+    c3c build batch_test_vm
+
+# Build the C3 Duktape CLI (for benchmarks)
+build-bench:
+    c3c build duktape_c3
+
+# Build original Duktape v2.7.0 for comparison benchmarks
+build-orig-duktape:
+    @cc -O2 -o out/duktape_orig duktape_cmdline.c $(ls duktape/src-separate/*.c) -I.
+
+# Build QuickJS CLI for comparison benchmarks
+build-quickjs:
+    make -C quickjs qjs
+    cp quickjs/qjs out/
+
+# Build the VM dispatch benchmark harness
+build-vm-dispatch:
+    c3c build vm_dispatch_bench
+
+# Run the VM dispatch benchmark harness
+bench-vm-dispatch:
+    @test -f out/vm_dispatch_bench || c3c build vm_dispatch_bench 2>/dev/null || { echo "Build failed"; exit 1; }
+    ./out/vm_dispatch_bench
+build t="duktape":
+    c3c build "{{t}}"
+
+# Build with NaN-boxing disabled (`-D NONANBOX`)
+build-nonanbox t="test_vm":
+    c3c -D NONANBOX build "{{t}}"
+
+# Build test_vm with NaN-boxing disabled and run a smoke test
+test-nonanbox file="test/simple.js":
+    c3c -D NONANBOX build test_vm
+    ./out/test_vm {{file}}
+
+# Clean build artifacts
+clean:
+    c3c clean
+
+# ── Run ──────────────────────────────────────────────────────────────────────
+
+# Run a single JS file through the VM test runner
+run file="test/simple.js":
+    @test -f out/test_vm && echo "need: c3c build test_vm" ; c3c build test_vm 2>/dev/null || true
+    ./out/test_vm {{file}}
+
+# ── Test262 ──────────────────────────────────────────────────────────────────
+
+# Run full test262 suite
+test262:
+    @test -f out/batch_test_vm || c3c build batch_test_vm 2>/dev/null || { echo "Build failed — source may have errors"; exit 1; }
+    python3 scripts/run_test262.py
+
+# Run a specific test262 phase (`just test262-phase 2`)
+test262-phase phase="0":
+    @test -f out/batch_test_vm || c3c build batch_test_vm 2>/dev/null || { echo "Build failed — source may have errors"; exit 1; }
+    python3 scripts/run_test262.py --phase {{phase}}
+
+# ── Benchmarks ───────────────────────────────────────────────────────────────
+
+# Run all benchmarks without rebuilding (default: 3 iterations)
+bench n="3":
+	@test -f out/duktape_c3 || { echo "ERROR: out/duktape_c3 not found — run: c3c build duktape_c3"; exit 1; }
+	@test -f out/duktape_orig || { echo "Building original Duktape..."; cc -O2 -o out/duktape_orig duktape_cmdline.c $(ls duktape/src-separate/*.c) -I.; }
+	@test -f out/qjs || { echo "Building QuickJS..."; make -C quickjs qjs && cp quickjs/qjs out/; }
+	bash scripts/run_benchmarks.sh {{n}}
+
+# Rebuild duktape_c3 and run all benchmarks
+bench-rebuild n="3":
+	c3c build duktape_c3
+	@test -f out/duktape_orig || { echo "Building original Duktape..."; cc -O2 -o out/duktape_orig duktape_cmdline.c $(ls duktape/src-separate/*.c) -I.; }
+	@test -f out/qjs || { echo "Building QuickJS..."; make -C quickjs qjs && cp quickjs/qjs out/; }
+	bash scripts/run_benchmarks.sh {{n}}
+
+# Run a single benchmark file: `just bench-one benchmarks/bench_loop.js`
+bench-one file n="3":
+    @test -f out/duktape_c3 || { echo "ERROR: out/duktape_c3 not found"; exit 1; }
+    ./out/duktape_c3 {{file}}
+
+# Run a single benchmark on original Duktape
+bench-orig file:
+	@test -f out/duktape_orig || { echo "Building original Duktape..."; cc -O2 -o out/duktape_orig duktape_cmdline.c $(ls duktape/src-separate/*.c) -I.; }
+	./out/duktape_orig {{file}}
+
+# ── Help ─────────────────────────────────────────────────────────────────────
+
+# List available commands
+list:
+    @just --list
