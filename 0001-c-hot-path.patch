+                i++;
+            } else if (b >= 0xC2 && b <= 0xF4) {
+                uint seq_len;
+                if (b < 0xE0) { seq_len = 2; }
+                else if (b < 0xF0) { seq_len = 3; }
+                else { seq_len = 4; }
