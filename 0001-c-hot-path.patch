+
+// Lookup from prototype chain (depth 2)
+for (var i = 0; i < N; i++) { sum += obj.c; }
+
+// Lookup from prototype chain (depth 3)
+for (var i = 0; i < N; i++) { sum += obj.b; }
+
+// Lookup from prototype chain (depth 4)
+for (var i = 0; i < N; i++) { sum += obj.a; }
